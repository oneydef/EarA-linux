#!/usr/bin/env python3
import sys
from pathlib import Path

for candidate in (Path("/usr/share/eara"), Path(__file__).resolve().parent.parent):
    if (candidate / "eara" / "__init__.py").exists():
        sys.path.insert(0, str(candidate))
        break

from eara.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
